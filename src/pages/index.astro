---
import Layout from "../layouts/Layout.astro";

// nav links with tooltips
const navLinks = [
    {
        name: "About",
        ne: "बारेमा",
        href: "#about",
        info: "Understand the Mission",
    },
    {
        name: "Principles",
        ne: "सिद्धान्तहरू",
        href: "#principles",
        info: "Core Philosophy",
    },
    {
        name: "Discoveries",
        ne: "खोजहरू",
        href: "#insights",
        info: "Latest Realizations",
    },
    {
        name: "Practices",
        ne: "अभ्यासहरू",
        href: "#resources",
        info: "Yogic Dance & Meditation",
    },
    { name: "GAN", ne: "GAN", href: "#gan", info: "Guru-Antiguru-Nonguru" },
    { name: "ANU", ne: "ANU", href: "#anu", info: "AI + NI = UI" },
    { name: "Mirror", ne: "ऐना", href: "#mirror", info: "Reflect What Is" },
    {
        name: "Friendly Journey",
        ne: "मैत्री यात्रा",
        href: "#friendly-journey",
        info: "Interactive Exploration",
    },
];
---

<Layout title="Human-Nature-Reality Movement">
    <header
        class="fixed top-0 w-full z-[100] transition-all duration-300 bg-black/60 backdrop-blur-lg"
    >
        <nav
            class="w-full px-4 md:px-8 py-4 flex flex-nowrap justify-between items-center gap-4 md:gap-10"
        >
            <!-- Left: Logo -->
            <div class="flex items-center flex-shrink-0">
                <a href="#" class="flex items-center gap-3 group">
                    <img
                        src="/hnr-logo-new.png"
                        alt="HNR Logo"
                        class="h-8 w-8 md:h-10 md:w-10 invert group-hover:rotate-12 transition-transform duration-500"
                    />
                    <span
                        class="text-lg md:text-2xl font-playfair font-bold text-transparent bg-clip-text bg-gradient-to-r from-yellow-200 via-white to-yellow-200 tracking-[0.15em] drop-shadow-lg transition-all duration-500 uppercase"
                        >HNR Movement</span
                    >
                </a>
            </div>

            <!-- Right: Nav Links + Language Tab -->
            <div class="flex items-center gap-3 md:gap-4 flex-1 justify-end">
                <div
                    class="flex gap-3 md:gap-4 lg:gap-6 items-center overflow-x-auto no-scrollbar scroll-smooth h-16"
                >
                    {
                        navLinks.map((link) => (
                            <div class="relative group/tooltip flex-shrink-0 flex items-center h-full">
                                <a
                                    href={link.href}
                                    class="relative text-[10px] md:text-[11px] lg:text-[12.5px] uppercase tracking-wide font-bold text-white/90 hover:text-cyan-300 transition-all duration-300 nav-text"
                                    data-en={link.name}
                                    data-ne={link.ne}
                                >
                                    {link.name}
                                    <span class="absolute -bottom-1 left-0 w-0 h-[2px] bg-gradient-to-r from-cyan-500 to-blue-500 group-hover/tooltip:w-full transition-all duration-300 shadow-[0_0_8px_rgba(34,211,238,0.8)]" />
                                </a>
                                <div class="absolute -bottom-12 left-1/2 -translate-x-1/2 opacity-0 group-hover/tooltip:opacity-100 transition-all duration-300 bg-black/95 px-3 py-1.5 rounded-lg text-[11px] text-cyan-200 whitespace-nowrap pointer-events-none border border-white/20 z-50 shadow-[0_0_20px_rgba(0,0,0,0.5)] backdrop-blur-md scale-95 group-hover/tooltip:scale-100">
                                    {link.info}
                                </div>
                            </div>
                        ))
                    }
                </div>

                <!-- Language Tab -->
                <div
                    class="flex items-center border border-white/30 rounded-full px-1 py-0.5 bg-white/10 flex-shrink-0 shadow-[0_0_15px_rgba(255,255,255,0.1)] ml-2"
                >
                    <button
                        id="lang-en"
                        class="px-2.5 py-1 text-[10px] md:text-[11px] font-black text-white bg-white/30 rounded-full shadow-inner transition-all"
                        >EN</button
                    >
                    <button
                        id="lang-ne"
                        class="px-2.5 py-1 text-[10px] md:text-[11px] font-bold text-gray-300 hover:text-white transition-colors"
                        >NE</button
                    >
                </div>
            </div>
        </nav>
    </header>

    <main>
        <!-- HERO SECTION -->
        <section
            id="home"
            class="min-h-screen flex flex-col items-center justify-center text-center px-4 pt-20 relative"
        >
            <div class="relative z-10">
                <p
                    class="text-sm md:text-lg text-cyan-200/80 mb-4 font-playfair italic tracking-wide quote-text"
                    data-en="Living through the body, we are the world, the Earth is our home, and life is our teacher."
                    data-ne="शरीरको माध्यमबाट बाँच्दै, हामी संसार हौं, पृथ्वी हाम्रो घर हो, र जीवन हाम्रो शिक्षक हो।"
                >
                    Living through the body, we are the world, the Earth is our
                    home, and life is our teacher.
                </p>
                <div
                    class="flex flex-wrap justify-center gap-4 md:gap-8 text-5xl md:text-7xl lg:text-8xl font-playfair font-bold text-white drop-shadow-2xl mb-2 items-center"
                >
                    <!-- Human -->
                    <div
                        class="relative group cursor-default h-20 md:h-32 flex items-center justify-center min-w-[200px]"
                    >
                        <span
                            class="group-hover:opacity-0 transition-all duration-500 ease-in-out block"
                            data-en="Human"
                            data-ne="मानव">Human</span
                        >
                        <span
                            class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-700 ease-in-out text-2xl md:text-3xl text-cyan-300 font-light whitespace-nowrap pointer-events-none"
                            data-en="We are the world."
                            data-ne="हामी नै संसार हौं।"
                        >
                            We are the world.
                        </span>
                    </div>

                    <!-- Nature -->
                    <div
                        class="relative group cursor-default h-20 md:h-32 flex items-center justify-center min-w-[200px]"
                    >
                        <span
                            class="group-hover:opacity-0 transition-all duration-500 ease-in-out block"
                            data-en="Nature"
                            data-ne="प्रकृति">Nature</span
                        >
                        <span
                            class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-700 ease-in-out text-2xl md:text-3xl text-green-300 font-light whitespace-nowrap pointer-events-none"
                            data-en="The Earth is our Home."
                            data-ne="पृथ्वी नै हाम्रो घर हो।"
                        >
                            The Earth is our Home.
                        </span>
                    </div>

                    <!-- Reality -->
                    <div
                        class="relative group cursor-default h-20 md:h-32 flex items-center justify-center min-w-[200px]"
                    >
                        <span
                            class="group-hover:opacity-0 transition-all duration-700 ease-in-out block"
                            data-en="Reality"
                            data-ne="वास्तविकता">Reality</span
                        >
                        <span
                            class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-700 ease-in-out text-2xl md:text-3xl text-purple-300 font-light whitespace-nowrap pointer-events-none"
                            data-en="Life - the best Teacher"
                            data-ne="जीवन - सबैभन्दा ठूलो शिक्षक"
                        >
                            Life - the best Teacher
                        </span>
                    </div>
                </div>

                <div class="relative group inline-block mb-8 cursor-default">
                    <h2
                        class="text-4xl md:text-6xl font-bold text-yellow-100 tracking-[0.3em] uppercase transition-all duration-700 ease-in-out group-hover:opacity-0 drop-shadow-[0_0_20px_rgba(253,224,71,0.6)] sub-title"
                        data-en="Movement"
                        data-ne="अभियान"
                    >
                        Movement
                    </h2>
                    <span
                        class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-700 ease-in-out text-2xl text-yellow-300 whitespace-nowrap font-light pointer-events-none"
                        data-en="The body is our vehicle."
                        data-ne="शरीर नै हाम्रो वाहन हो।"
                    >
                        The body is our vehicle.
                    </span>
                </div>

                <p
                    class="text-lg md:text-xl font-light text-gray-300 tracking-wide max-w-2xl mx-auto mb-10 drop-shadow-lg italic hero-subtitle"
                    data-en='"A Mirror of Urgency into What Is"'
                    data-ne='"जे छ त्यसको अत्यावश्यकताको ऐना"'
                >
                    "A Mirror of Urgency into What It Is"
                </p>
            </div>

            <div class="flex flex-col md:flex-row gap-6 mt-4 mb-6 z-10">
                <a
                    href="https://www.youtube.com/channel/UCwij_PdHTz1aQ8w5NVCI95A"
                    target="_blank"
                    class="px-8 py-3 bg-red-600/80 hover:bg-red-600 text-white rounded-full font-bold tracking-wider transition-all hover:scale-105 shadow-[0_0_20px_rgba(220,38,38,0.5)] backdrop-blur-md flex items-center justify-center gap-2"
                >
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
                        ><path
                            d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"
                        ></path></svg
                    >
                    <span
                        class="btn-text"
                        data-en="YouTube Channel"
                        data-ne="युट्युब च्यानल">YouTube Channel</span
                    >
                </a>
                <a
                    href="#join"
                    class="px-8 py-3 border border-cyan-400/50 hover:bg-cyan-500/20 text-cyan-100 rounded-full font-bold tracking-wider transition-all hover:scale-105 shadow-[0_0_20px_rgba(34,211,238,0.3)] backdrop-blur-md"
                >
                    <span
                        class="btn-text"
                        data-en="Join the Movement"
                        data-ne="अभियानमा सामेल हुनुहोस्"
                        >Join the Movement</span
                    >
                </a>
                <a
                    href="#socials"
                    class="px-8 py-3 bg-blue-600/50 hover:bg-blue-600 text-white rounded-full font-bold tracking-wider transition-all hover:scale-105 shadow-[0_0_20px_rgba(37,99,235,0.5)] backdrop-blur-md"
                >
                    <span
                        class="btn-text"
                        data-en="Social Media Connection"
                        data-ne="सामाजिक सञ्जाल सम्पर्क"
                        >Social Media Connection</span
                    >
                </a>
            </div>

            <p
                class="text-md text-cyan-100/60 uppercase tracking-widest mb-2 explore-text"
                data-en="Let Us Explore"
                data-ne="आउनुहोस् अन्वेषण गरौं"
            >
                Let Us Explore
            </p>

            <div class="animate-bounce text-white/50">
                <svg
                    class="w-6 h-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg
                >
            </div>
        </section>

        <!-- CORE PRINCIPLES (Interactive 3 Columns) -->
        <section id="principles" class="py-32 px-4 relative overflow-hidden">
            <!-- Interactive Containers -->
            <div
                class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8 h-auto md:h-[700px] items-center py-10 md:py-0"
            >
                <!-- Column 1: Human (Hover -> GAN) -->
                <div
                    class="group relative flex flex-col items-center justify-center h-full border-r-0 md:border-r border-white/10 hover:bg-white/5 transition-all duration-700 cursor-pointer" onclick="window.location.href='#gan'"
                >
                    <h2
                        class="text-5xl font-playfair font-bold text-white group-hover:text-transparent group-hover:bg-clip-text group-hover:bg-gradient-to-b group-hover:from-yellow-200 group-hover:to-orange-500 transition-all duration-500 z-10"
                    >
                        Human
                    </h2>

                    <!-- Expanded State -->
                    <div
                        class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-700 pointer-events-none transform scale-90 group-hover:scale-100"
                    >
                        <div class="relative w-72 h-72">
                            <!-- Infinite SVG Background -->
                            <div
                                class="absolute inset-0 border-[0.5px] border-white/20 rounded-full animate-spin-slow"
                            >
                            </div>
                            <div
                                class="absolute inset-4 border-[0.5px] border-white/10 rounded-full animate-orbit"
                            >
                            </div>

                            <!-- Nonguru (Top) -->
                            <div
                                class="absolute -top-12 left-1/2 -translate-x-1/2 text-center animate-float pointer-events-auto w-full"
                            >
                                <a
                                    href="/explore/nonguru"
                                    class="block text-2xl font-bold text-yellow-300 drop-shadow-[0_0_10px_rgba(253,224,71,0.5)] hover:scale-110 transition-transform"
                                    data-en="Nonguru"
                                    data-ne="गैर-गुरु">Nonguru</a
                                >
                            </div>

                            <!-- Guru (Left) -->
                            <div
                                class="absolute top-20 -left-12 text-right animate-float pointer-events-auto"
                                style="animation-delay: 1s;"
                            >
                                <a
                                    href="/explore/guru"
                                    class="block text-xl font-bold text-blue-300 drop-shadow-[0_0_10px_rgba(147,197,253,0.5)] hover:scale-110 transition-transform"
                                    data-en="Guru"
                                    data-ne="गुरु">Guru</a
                                >
                            </div>

                            <!-- Antiguru (Right) -->
                            <div
                                class="absolute top-20 -right-12 text-left animate-float pointer-events-auto"
                                style="animation-delay: 2s;"
                            >
                                <a
                                    href="/explore/antiguru"
                                    class="block text-xl font-bold text-red-300 drop-shadow-[0_0_10px_rgba(252,165,165,0.5)] hover:scale-110 transition-transform"
                                    data-en="Antiguru"
                                    data-ne="एन्टिगुरु">Antiguru</a
                                >
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Column 2: Nature (Hover -> ANU) -->
                <div
                    class="group relative flex flex-col items-center justify-center h-full border-r-0 md:border-r border-white/10 hover:bg-white/5 transition-all duration-700 cursor-pointer" onclick="window.location.href='#anu'"
                >
                    <h2
                        class="text-5xl font-playfair font-bold text-white group-hover:text-transparent group-hover:bg-clip-text group-hover:bg-gradient-to-tr group-hover:from-green-300 group-hover:to-cyan-500 transition-all duration-500 z-10"
                    >
                        Nature
                    </h2>

                    <!-- Expanded State (Circular Layout for Nature) -->
                    <div
                        class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-700 pointer-events-none transform scale-90 group-hover:scale-100"
                    >
                        <div class="relative w-72 h-72">
                            <div
                                class="absolute inset-0 border-[0.5px] border-cyan-500/20 rounded-full animate-spin-slow"
                                style="animation-duration: 40s;"
                            >
                            </div>

                            <!-- Universal Intelligence (Top) -->
                            <div
                                class="absolute -top-12 left-1/2 -translate-x-1/2 text-center animate-float pointer-events-auto w-full"
                            >
                                <a
                                    href="/explore/ui"
                                    class="block text-2xl font-bold text-cyan-300 drop-shadow-lg hover:scale-110 transition-transform"
                                    data-en="Universal Intelligence"
                                    data-ne="ब्रह्माण्डीय विवेक"
                                    >Universal Intelligence</a
                                >
                            </div>

                            <!-- Artificial Intelligence (Left) -->
                            <div
                                class="absolute top-20 -left-12 text-right animate-float pointer-events-auto"
                                style="animation-delay: 0.5s;"
                            >
                                <a
                                    href="/explore/ai"
                                    class="block text-xl font-bold text-purple-300 drop-shadow-lg hover:scale-110 transition-transform leading-tight"
                                    data-en="Artificial Intelligence"
                                    data-ne="कृत्रिम विवेक"
                                    >Artificial Intelligence</a
                                >
                            </div>

                            <!-- Natural Intelligence (Right) -->
                            <div
                                class="absolute top-20 -right-12 text-left animate-float pointer-events-auto"
                                style="animation-delay: 1s;"
                            >
                                <a
                                    href="/explore/ni"
                                    class="block text-xl font-bold text-green-300 drop-shadow-lg hover:scale-110 transition-transform leading-tight"
                                    data-en="Natural Intelligence"
                                    data-ne="प्राकृतिक विवेक"
                                    >Natural Intelligence</a
                                >
                            </div>

                            <!-- Central ANU Tag -->
                            <div
                                class="absolute inset-0 flex items-center justify-center pointer-events-none"
                            >
                                <span class="text-6xl font-bold text-white/5"
                                    >ANU</span
                                >
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Column 3: Reality (Hover -> Mirror) -->
                <div
                    class="group relative flex flex-col items-center justify-center h-full hover:bg-white/5 transition-all duration-700 cursor-pointer" onclick="window.location.href='#mirror'"
                >
                    <h2
                        class="text-5xl font-playfair font-bold text-white group-hover:text-transparent group-hover:bg-clip-text group-hover:bg-gradient-to-br group-hover:from-gray-200 group-hover:to-white transition-all duration-500 z-10"
                    >
                        Reality
                    </h2>

                    <!-- Expanded State -->
                    <div
                        class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-700 pointer-events-none transform scale-90 group-hover:scale-100"
                    >
                        <div class="relative w-72 h-72">
                            <div
                                class="absolute inset-0 bg-white/5 rounded-full blur-xl"
                            >
                            </div>

                            <!-- Mirror (Top) -->
                            <div
                                class="absolute -top-12 left-1/2 -translate-x-1/2 text-center pointer-events-auto w-full"
                            >
                                <a
                                    href="#mirror"
                                    class="block text-2xl font-bold text-white drop-shadow-[0_0_10px_rgba(255,255,255,0.8)] hover:scale-110 transition-transform animate-rainbow"
                                    data-en="Mirror"
                                    data-ne="ऐना">Mirror</a
                                >
                            </div>

                            <!-- What Is (Left) -->
                            <div
                                class="absolute top-20 -left-12 text-right pointer-events-auto"
                            >
                                <a
                                    href="#mirror"
                                    class="block text-xl font-bold text-white hover:scale-110 transition-transform animate-rainbow"
                                    style="animation-delay: 1s;"
                                    data-en="What Is"
                                    data-ne="जे छ">What Is</a
                                >
                            </div>

                            <!-- Urgency (Right) - Distinct Color -->
                            <div
                                class="absolute top-20 -right-12 text-left pointer-events-auto"
                            >
                                <a
                                    href="#mirror"
                                    class="block text-xl font-bold text-red-500 animate-pulse hover:text-red-400 hover:scale-110 transition-transform"
                                    data-en="Urgency"
                                    data-ne="तत्काल">Urgency</a
                                >
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- GAN EXPLAINER -->
        <section id="gan" class="py-24 bg-black/40 backdrop-blur-sm">
            <div class="container mx-auto px-6">
                <h3
                    class="text-4xl font-playfair text-center mb-16 text-transparent bg-clip-text bg-gradient-to-r from-yellow-200 via-white to-yellow-200"
                    data-en="The Universal Play of Consciousness"
                    data-ne="चेतनाको विश्वव्यापी खेल"
                >
                    The Universal Play of Consciousness
                </h3>
                <div class="grid md:grid-cols-3 gap-10">
                    <div
                        class="p-8 border border-white/10 rounded-xl bg-gradient-to-b from-white/5 to-transparent hover:scale-105 transition-transform group cursor-pointer" onclick="window.location.href='/explore/guru'"
                    >
                        <div class="text-4xl mb-4 group-hover:animate-bounce">
                            🧘
                        </div>
                        <h4
                            class="text-2xl font-bold mb-2 text-blue-200"
                            data-en="Guru"
                            data-ne="गुरु"
                        >
                            Guru
                        </h4>
                        <p
                            class="text-gray-400"
                            data-en="The archetype of tradition, guidance, and knowledge. The pointer to the moon."
                            data-ne="परम्परा, मार्गदर्शन र ज्ञानको आद्यरूप। चन्द्रमा तर्फको औंला।"
                        >
                            The archetype of tradition, guidance, and knowledge.
                            The pointer to the moon.
                        </p>
                    </div>
                    <div
                        class="p-8 border border-white/10 rounded-xl bg-gradient-to-b from-white/5 to-transparent hover:scale-105 transition-transform group cursor-pointer" onclick="window.location.href='/explore/antiguru'"
                    >
                        <div class="text-4xl mb-4 group-hover:animate-pulse">
                            ⚡
                        </div>
                        <h4
                            class="text-2xl font-bold mb-2 text-red-200"
                            data-en="Antiguru"
                            data-ne="एन्टिगुरु"
                        >
                            Antiguru
                        </h4>
                        <p
                            class="text-gray-400"
                            data-en="The deconstruction of authority. Questioning spiritual correctness and breaking illusions."
                            data-ne="अधिकारको विनिर्माण। आध्यात्मिक शुद्धतामाथि प्रश्न र भ्रमहरूको अन्त्य।"
                        >
                            The deconstruction of authority. Questioning
                            spiritual correctness and breaking illusions.
                        </p>
                    </div>
                    <div
                        class="p-8 border border-white/10 rounded-xl bg-gradient-to-b from-white/5 to-transparent hover:scale-105 transition-transform group cursor-pointer" onclick="window.location.href='/explore/nonguru'"
                    >
                        <div
                            class="text-4xl mb-4 group-hover:animate-spin-slow"
                        >
                            🌀
                        </div>
                        <h4
                            class="text-2xl font-bold mb-2 text-yellow-200"
                            data-en="Nonguru"
                            data-ne="ननगुरु"
                        >
                            Nonguru
                        </h4>
                        <p
                            class="text-gray-400"
                            data-en="Truth is not owned, transmitted, or taught. The absence of the teacher-student identity."
                            data-ne="सत्य कसैको स्वामित्वमा हुँदैन, यो हस्तान्तरण वा सिकाइँदैन। गुरु-शिष्य पहिचानको अभाव।"
                        >
                            Truth is not owned, transmitted, or taught. The
                            absence of the teacher-student identity.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ANU SECTION (AI + NI = UI) -->
        <!-- ANU SECTION (COMPACT DESIGN FOR ONE-CLICK VISIBILITY) -->
        <section
            id="anu"
            class="py-12 md:py-16 relative overflow-hidden bg-white/[0.02] scroll-mt-10"
        >
            <div class="container mx-auto px-6 relative z-10">
                <div class="text-center mb-8">
                    <h2
